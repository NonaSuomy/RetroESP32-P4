# === Build outputs ===
build/
**/build/
**/build (1)/
build_papp/
**/managed_components/

# === Firmware binaries (all generated) ===
firmware/

# === ESP-IDF generated config (only .defaults are tracked) ===
sdkconfig
**/sdkconfig
!sdkconfig.defaults
!**/sdkconfig.defaults
!apps/sdkconfig_common.defaults

# === ESP-IDF lock file (regenerated by build) ===
**/dependencies.lock

# === Text files (logs, captures, temp notes) ===
*.txt

# === Temporary/check binaries ===
*.check.bin
bl_check.bin
bootloader_check.bin
factory_check.bin
otadata_check.bin
otadata_snes.bin
part_table_readback.bin
snes_header_check.bin
temp_launcher_check.bin
tmp_factory.bin

# === Markdown docs (README + published reference docs tracked; rest stay local) ===
*.md
!README.md
!ARCHITECTURE.md
!PAPP_GUIDE.md
!PAPP_SCUMMVM.md

# === Backup directories ===
backup_pre_superfx/

# === One-off Python debug/capture scripts in root (not needed to build) ===
# Ignore all .py in root, then un-ignore the essential build tools
/*.py
!gen_ctile.py
!gen_vrom.py
!verify_ctile.py

# === IDE / editor ===
.vscode/
*.code-workspace

# === OS files ===
Thumbs.db
.DS_Store
desktop.ini
ehthumbs.db
Desktop.ini

# === Python ===
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# === Excel validation matrix (CSV is tracked) ===
validation_matrix.xlsx

# === Vendored third-party libraries (see docs/LVGL_PAPP.md to re-fetch) ===
third_party/
build_papp/

# The Quake PAPP carries its MP3 decoder so the build does not depend on an
# ESPHome component cache being present on the build machine.
!apps/psram_quake/third_party/
!apps/psram_quake/third_party/micro-mp3/
!apps/psram_quake/third_party/micro-mp3/opencore-mp3dec/
!apps/psram_quake/third_party/micro-mp3/opencore-mp3dec/**
